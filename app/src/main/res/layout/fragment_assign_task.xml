<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_24">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/spacing_40"
                android:layout_height="@dimen/spacing_40"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Giao bài cho con"
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="@dimen/spacing_12" />

        </LinearLayout>

        <!-- Chọn con -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn con"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_8" />

        <Spinner
            android:id="@+id/spinnerChild"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_48"
            android:background="@drawable/bg_input"
            android:padding="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_16" />

        <!-- Loại bài tập (chỉ EXERCISE và HABIT) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loại bài tập"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_8" />

        <RadioGroup
            android:id="@+id/radioGroupTaskType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_16">

            <RadioButton
                android:id="@+id/radioExercise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bài tập"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioHabit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thói quen" />

        </RadioGroup>

        <!-- Chọn bài tập (chỉ hiện khi chọn "Bài tập") -->
        <LinearLayout
            android:id="@+id/layoutExerciseSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn bài tập"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_8" />

            <Spinner
                android:id="@+id/spinnerExercise"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_48"
                android:background="@drawable/bg_input"
                android:padding="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_16" />

        </LinearLayout>

        <!-- Chọn thói quen (chỉ hiện khi chọn "Thói quen") -->
        <LinearLayout
            android:id="@+id/layoutHabitSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn thói quen"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_8" />

            <Spinner
                android:id="@+id/spinnerHabit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_48"
                android:background="@drawable/bg_input"
                android:padding="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_16" />

        </LinearLayout>

        <!-- Thông tin template đã chọn -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSelectedTemplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_16"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_12">

                <TextView
                    android:id="@+id/tvTemplateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvTemplateDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_4" />

                <TextView
                    android:id="@+id/tvTemplateReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/primary"
                    android:layout_marginTop="@dimen/spacing_4" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Ghi chú của phụ huynh -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghi chú cho con (tùy chọn)"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_8" />

        <EditText
            android:id="@+id/edtParentNote"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_96"
            android:background="@drawable/bg_input"
            android:padding="@dimen/spacing_12"
            android:hint="Ví dụ: Con cố gắng hoàn thành trước 8h tối nhé!"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="@dimen/spacing_16" />

        <!-- Hạn hoàn thành -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hạn hoàn thành"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_16">

            <EditText
                android:id="@+id/edtDueDate"
                android:layout_width="0dp"
                android:layout_height="@dimen/spacing_48"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:padding="@dimen/spacing_12"
                android:hint="Ngày (dd/MM/yyyy)"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginEnd="@dimen/spacing_8" />

            <EditText
                android:id="@+id/edtDueTime"
                android:layout_width="0dp"
                android:layout_height="@dimen/spacing_48"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:padding="@dimen/spacing_12"
                android:hint="Giờ (HH:mm)"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />

        </LinearLayout>

        <!-- Bắt buộc -->
        <CheckBox
            android:id="@+id/cbMandatory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bắt buộc hoàn thành"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/spacing_16" />

        <!-- Độ ưu tiên -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Độ ưu tiên"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_8" />

        <RadioGroup
            android:id="@+id/radioGroupPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_24">

            <RadioButton
                android:id="@+id/radioPriorityLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thấp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioPriorityMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trung bình" />

            <RadioButton
                android:id="@+id/radioPriorityHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cao" />

        </RadioGroup>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Nút giao bài -->
        <Button
            android:id="@+id/btnAssignTask"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_48"
            android:text="Giao bài"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:layout_marginTop="@dimen/spacing_8" />

    </LinearLayout>

</ScrollView>
