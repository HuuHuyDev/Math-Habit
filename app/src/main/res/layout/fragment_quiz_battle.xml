<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/primary"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtBattleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thách đấu"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginHorizontal="16dp" />

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:00"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_background"
            android:backgroundTint="@color/accent"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Challenge Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/txtChallengeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Câu đố mẹo - 10 câu hỏi"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtQuestionNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Câu 1/10"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Question Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Câu hỏi sẽ hiển thị ở đây..."
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.2"
                android:gravity="center" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Answer Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnAnswer1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đáp án A"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnAnswer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đáp án B"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnAnswer3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đáp án C"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnAnswer4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đáp án D"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="20dp"
            android:padding="16dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Câu tiếp theo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_primary"
            android:padding="16dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>