<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheet Add Task - Thêm nhiệm vụ mới với API -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/spacing_20">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_16"
        android:background="@drawable/bg_bottomsheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="Thêm nhiệm vụ mới"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_title" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/spacing_16" />

    <!-- ScrollView để cuộn nội dung -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Task Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Loại nhiệm vụ"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_medium" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTaskType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:checkedChip="@id/chipExercise"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExercise"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài tập"
                    app:chipIcon="@drawable/ic_quiz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHabit"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thói quen"
                    app:chipIcon="@drawable/ic_habit" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Layout cho Bài tập (Exercise) -->
            <LinearLayout
                android:id="@+id/layoutExercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Chọn bài tập -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Chọn bài tập"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_medium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExercise"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="Chọn bài tập"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerExercise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:fontFamily="@font/inter_regular" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Layout cho Thói quen (Habit) -->
            <LinearLayout
                android:id="@+id/layoutHabit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Chọn thói quen -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Chọn thói quen"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_medium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHabit"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="Chọn thói quen"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerHabit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:fontFamily="@font/inter_regular" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Lặp lại -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Lặp lại hàng ngày"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRecurring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Giờ hoàn thành (Due Time) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDueTime"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:hint="Giờ hoàn thành (VD: 18:00)"
                app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                app:boxCornerRadiusTopStart="@dimen/radius_medium"
                app:prefixText="🕐 ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDueTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:fontFamily="@font/inter_regular"
                    android:inputType="none"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Giờ nhắc nhở (Reminder Time) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReminderTime"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="Giờ nhắc nhở (VD: 17:30)"
                app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                app:boxCornerRadiusTopStart="@dimen/radius_medium"
                app:prefixText="🔔 ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtReminderTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:fontFamily="@font/inter_regular"
                    android:inputType="none"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ghi chú của phụ huynh -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilParentNote"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="Ghi chú cho bé (tùy chọn)"
                app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                app:boxCornerRadiusTopStart="@dimen/radius_medium"
                app:prefixText="📝 ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtParentNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Độ ưu tiên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:fontFamily="@font/inter_semibold"
                android:text="Độ ưu tiên"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_medium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPriority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="1"
                android:valueFrom="1"
                android:valueTo="5"
                app:labelBehavior="withinBounds" />

            <!-- Bắt buộc -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Bắt buộc hoàn thành"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_medium" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMandatory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_8"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="Hủy"
            android:textColor="@color/text_secondary"
            app:cornerRadius="@dimen/radius_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:backgroundTint="#2D5FFF"
            android:fontFamily="@font/inter_bold"
            android:text="Giao bài"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/radius_medium" />

    </LinearLayout>

</LinearLayout>
