<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/frameBadge"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_achievement_gold">

        <ImageView
            android:id="@+id/imgBadge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_trophy" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvBadgeName"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:maxLines="2"
        android:text="Badge Name"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <!-- Status for earned -->
    <TextView
        android:id="@+id/tvStatusEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_status_owned"
        android:fontFamily="@font/inter_medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="✓ Đạt"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Progress for in-progress -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBadge"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:progress="0"
            app:indicatorColor="@color/coin_orange"
            app:trackColor="#FFE5CC"
            app:trackCornerRadius="3dp" />

        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_medium"
            android:text="0/10"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Requirement for locked -->
    <TextView
        android:id="@+id/tvRequirement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_medium"
        android:text="Đạt level 10"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
