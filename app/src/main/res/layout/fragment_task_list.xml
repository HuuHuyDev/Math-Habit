<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_background"
    tools:context=".ui.child.task.ChildTaskListFragment">

    <!-- Header với avatar và thông báo -->
    <com.kidsapp.ui.child.components.HeaderUserView
        android:id="@+id/headerUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Nội dung chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_app_background">

        <!-- Navigation Bar - Quay lại -->
        <LinearLayout
            android:id="@+id/layoutBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:layout_marginStart="@dimen/spacing_12"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/task_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:text="@string/task_back"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_medium"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <!-- TabLayout - 3 tabs: Thói quen | Học tập | Lịch sử -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginHorizontal="@dimen/spacing_16"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabBackground="@drawable/bg_tab_selector"
                app:tabTextColor="@color/text_secondary"
                app:tabSelectedTextColor="@color/white"
                app:tabRippleColor="@android:color/transparent"
                app:tabTextAppearance="@style/TabTextStyle" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ViewPager2 - Chiếm toàn bộ không gian còn lại -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_8"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </LinearLayout>

</LinearLayout>
