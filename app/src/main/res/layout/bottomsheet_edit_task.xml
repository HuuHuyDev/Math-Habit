<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheet Edit Task - Chỉnh sửa nhiệm vụ đã giao -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/spacing_20">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_16"
        android:background="@drawable/bg_bottomsheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="Chỉnh sửa nhiệm vụ"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_title" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/spacing_16" />

    <!-- Task Type (READ ONLY) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:text="Loại nhiệm vụ"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_medium" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chipTaskType"
        style="@style/Widget.Material3.Chip.Assist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:clickable="false"
        android:enabled="false"
        android:text="Thói quen"
        app:chipIcon="@drawable/ic_habit" />

    <!-- Task Name (READ ONLY) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:fontFamily="@font/inter_semibold"
        android:text="Tên nhiệm vụ"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_medium" />

    <TextView
        android:id="@+id/tvTaskName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:background="@drawable/bg_card_white_pure"
        android:fontFamily="@font/inter_regular"
        android:padding="@dimen/spacing_12"
        android:text="Rửa tay trước ăn"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_medium" />

    <!-- Task Description (READ ONLY) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:fontFamily="@font/inter_semibold"
        android:text="Mô tả"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_medium" />

    <TextView
        android:id="@+id/tvTaskDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:background="@drawable/bg_card_white_pure"
        android:fontFamily="@font/inter_regular"
        android:minHeight="60dp"
        android:padding="@dimen/spacing_12"
        android:text="Rửa tay sạch sẽ trước khi ăn"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_medium" />

    <!-- Due Date (EDITABLE) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDueDate"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:hint="Ngày hết hạn *"
        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
        app:boxCornerRadiusTopStart="@dimen/radius_medium"
        app:prefixText="📅 "
        app:startIconDrawable="@drawable/ic_calendar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:fontFamily="@font/inter_regular"
            android:inputType="none"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Due Time (EDITABLE) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDueTime"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:hint="Giờ hoàn thành (VD: 18:00)"
        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
        app:boxCornerRadiusTopStart="@dimen/radius_medium"
        app:prefixText="🕐 ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDueTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:fontFamily="@font/inter_regular"
            android:inputType="none"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Reminder Time (EDITABLE) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReminderTime"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:hint="Giờ nhắc nhở (VD: 17:30)"
        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
        app:boxCornerRadiusTopStart="@dimen/radius_medium"
        app:prefixText="🔔 ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtReminderTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:fontFamily="@font/inter_regular"
            android:inputType="none"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Parent Note (EDITABLE) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilParentNote"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:hint="Ghi chú cho bé"
        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
        app:boxCornerRadiusTopStart="@dimen/radius_medium"
        app:prefixText="📝 ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtParentNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Priority (EDITABLE) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:fontFamily="@font/inter_semibold"
        android:text="Độ ưu tiên"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_medium" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPriority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1"
        android:valueTo="5"
        android:stepSize="1"
        android:value="1"
        app:labelBehavior="floating"
        app:tickVisible="true"
        app:trackColorActive="@color/primary"
        app:thumbColor="@color/primary" />

    <!-- Recurring (EDITABLE) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="Lặp lại hàng ngày"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_medium" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchRecurring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/spacing_16"
        android:visibility="gone" />


    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_8"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="Hủy"
            android:textColor="@color/text_secondary"
            app:cornerRadius="@dimen/radius_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdate"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:backgroundTint="#2D5FFF"
            android:fontFamily="@font/inter_bold"
            android:text="Cập nhật"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/radius_medium" />

    </LinearLayout>

</LinearLayout>

</ScrollView>
